    {"id": "non-e-solo", "regex": "(?i)\\bnon (?:è|e') (?:solo|soltanto|semplicemente) [^.!?\\n]{2,60}[,.;:]\\s*(?:è|e')\\b", "name": "\"Non è solo X, è Y\"", "fix": "Di' direttamente Y. La premessa negata è il segnale."},
    {"id": "non-solo-ma-anche", "regex": "(?i)\\bnon solo\\b[^.!?\\n]{2,80}\\bma anche\\b", "name": "\"Non solo X ma anche Y\"", "fix": "Due frasi, oppure tieni solo la metà più forte."},
    {"id": "non-si-tratta", "regex": "(?i)\\bnon si tratta (?:di|solo di) [^.!?\\n]{2,60}[.!,;:]\\s*si tratta di\\b", "name": "\"Non si tratta di X. Si tratta di Y.\"", "fix": "Apri con Y. Il ribaltamento è il segnale."},
    {"id": "domanda-svelata", "regex": "(?im)(?:^|[.!]\\s+)(?:il risultato|la parte migliore|il bello|il problema|il segreto|la verità|il punto|la differenza|il motivo|la soluzione|la lezione)\\?(?=\\s|$)", "name": "Domanda retorica di una parola (\"Il risultato?\")", "fix": "Togli la domanda e scrivi direttamente la risposta."},
    {"id": "ecco-cosa", "regex": "(?i)\\becco (?:cosa|quello che) (?:ho|abbiamo) imparato\\b|(?m)^\\s*ecco (?:la verità|il punto|il segreto|perché)\\s*:\\s*$", "name": "\"Ecco cosa ho imparato\" / \"Ecco il punto:\"", "fix": "Parti dalla lezione, senza annunciarla."},
    {"id": "triade", "regex": "\\b[^\\W\\d_]+, [^\\W\\d_]+ e [^\\W\\d_]+\\.", "name": "Triade di tre termini (X, Y e Z.)", "fix": "Tieni i due che contano. Il terzo è quasi sempre riempitivo."},
    {"id": "emoji-razzo", "regex": "[\\U0001F680\\U0001F525\\U0001F4A1\\u2728\\U0001F3AF\\U0001F447\\U0001F449]", "name": "Emoji da LinkedIn (razzo, fuoco, lampadina, dito)", "fix": "Toglile."},
    {"id": "muro-hashtag", "regex": "(?:#[^\\W_][\\w]*[ \\t]*){4,}", "name": "Muro di hashtag", "fix": "Massimo tre, in fondo."},
    {"id": "come-ia", "regex": "(?i)\\bcome (?:intelligenza artificiale|modello linguistico|ia)\\b", "name": "Autoriferimento da IA", "fix": "Cancella."},
    {"id": "in-sintesi", "regex": "(?im)^\\s*(?:in sintesi|in conclusione|riassumendo|per concludere|in definitiva|tirando le somme)\\b", "name": "Chiusura da tema (\"In sintesi\")", "fix": "Il post finisce quando hai detto la cosa. Niente riepilogo."},
    {"id": "esca-commenti", "regex": "(?i)(?:sei d'accordo\\?|siete d'accordo\\?|cosa ne pensate\\?|cosa ne pensi\\?|voi che ne dite\\?|chi altro\\b[^\\n]{0,40}\\?|sbaglio\\?)\\s*$", "name": "Esca per commenti generica", "fix": "Chiudi con una domanda che solo questo post può fare, o con un'istruzione."},
    {"id": "immagina", "regex": "(?im)^\\s*(?:immagina|immaginate|pensa|pensate) (?:di|a|se|un)\\b", "name": "Apertura \"Immagina...\"", "fix": "Racconta il fatto vero invece dello scenario ipotetico."},
    {"id": "domanda-risposta", "regex": "(?m)^[^\\n?]{3,60}\\?\\s*\\n+\\s*(?:Semplice|Facile|Ecco|La risposta)\\b", "name": "Domanda seguita da \"Semplice:\" / \"Ecco:\"", "fix": "Elimina la domanda, tieni la risposta."}
  ]
